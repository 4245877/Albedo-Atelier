[Unit]
Description=Atelier — full backup (queue.db + artifacts + secrets)
Documentation=file:%h/apps/atelier/ops/backup/README.md
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/apps/atelier
ExecStart=%h/apps/atelier/ops/backup/backup.sh --full
SuccessExitStatus=0
Nice=10
IOSchedulingClass=idle
