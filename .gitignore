node_modules/
dist/
.env
.env.*
!.env.example
npm-debug.log*
# Local persisted state written by `pnpm dev` / `pnpm start` (STATE_FILE_PATH).
# In Docker this lives on the named `orchestrator-data` volume instead.
apps/print-orchestrator/data/

# Real printer inventory: hosts, Bambu serial + LAN access code. Lives only on
# this host (mounted read-only into the orchestrator container); commit the
# scrubbed printers.example.json instead.
apps/print-orchestrator/config/printers.json

# Deploy state written by scripts/deploy.sh: the flock lock file, the build log
# and the recorded previous-image tags a `deploy.sh rollback` returns to. Host
# specific — never committed.
.deploy/

# Host-specific backup configuration (paths and retention, never secrets).
ops/backup/backup.conf

# SSH key material must never enter this repository. Added after an ED25519
# keypair was committed to the repo ROOT under a bare numeric name (`42477`,
# `42477.pub`) and pushed — a name no pattern would have caught, which is why
# the rules below match by SHAPE (extension, PEM body, conventional prefixes)
# rather than by filename.
*.pem
*.key
*.p12
*.pfx
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519
id_*.pub
*_rsa
*_ed25519
*.pub
# The private half of a bare-name pair (`42477`) has no shape to match on, so
# .gitignore cannot catch it. That half is caught by CONTENT instead, by the
# `secret-scan` job in .github/workflows/ci.yml, which fails the build on any
# committed PEM private-key header.
